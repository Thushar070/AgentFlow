# Local default. For Neon, use its pooled PostgreSQL URL and keep sslmode=require.
DATABASE_URL=postgresql+psycopg://agentflow:replace-with-a-random-password@127.0.0.1:5432/agentflow
# Keep Neon application traffic on the pooled URL; use its direct URL for Alembic.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT_SECONDS=10
REDIS_URL=redis://127.0.0.1:6379/0
# Neon env pull also provides DATABASE_URL_UNPOOLED for Alembic migrations.
API_HOST=127.0.0.1
API_PORT=8001
CORS_ORIGINS=["http://localhost:3000"]
ACTION_TIMEOUTS={}
APPROVAL_REQUIRED_ACTIONS=[]
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=12
MAX_REQUEST_BODY_BYTES=1048576
MAX_RUNS_PER_HOUR=100
APPROVAL_TTL_HOURS=24
APP_ENV=development
HTTP_ALLOWED_HOSTS=[]
HTTP_ALLOWED_PORTS=[443]
HTTP_MAX_RESPONSE_BYTES=262144
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
FREELLMAPI_TIMEOUT_SECONDS=120
OLLAMA_BASE_URL=http://localhost:11434/v1
